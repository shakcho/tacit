TACIT_DATABASE_URL=postgres://tacit_dev:tacit_dev@127.0.0.1:54330/tacit_dev?sslmode=disable
TACIT_DATABASE_DIRECT_URL=postgres://tacit_dev:tacit_dev@127.0.0.1:54330/tacit_dev?sslmode=disable
TACIT_TEST_DATABASE_URL=postgres://tacit_dev:tacit_dev@127.0.0.1:54330/tacit_test_source?sslmode=disable
TACIT_API_ORIGIN=http://127.0.0.1:8080
TACIT_WEB_ORIGIN=http://127.0.0.1:3000
TACIT_ENV=development

# WorkOS browser session configuration. Copy these to apps/web/.env.local.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=generate_at_least_32_random_characters
WORKOS_ISSUER=https://replace-with-the-exact-token-issuer.example
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Optional outside local demo mode; pins sign-in to an admitted WorkOS organization.
TACIT_WORKOS_ORGANIZATION_ID=org_replace_me

# Go identity verifier and webhook configuration.
TACIT_IDENTITY_NAMESPACE=workos-staging-client_replace_me
TACIT_WORKOS_ISSUER=https://replace-with-the-exact-token-issuer.example
TACIT_WORKOS_CLIENT_ID=client_replace_me
TACIT_WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me
TACIT_WORKOS_WEBHOOK_SECRET=whsec_replace_me
# Set the same independent random secret of at least 32 bytes on each API replica in production.
# TACIT_REALTIME_CURSOR_KEY=
# Set a direct or session-pooled PostgreSQL URL when TACIT_DATABASE_URL is transaction-pooled.
# TACIT_REALTIME_LISTEN_DATABASE_URL=
# Set only while an operator registers a reviewed invitation grant.
# TACIT_ALLOW_INVITATION_GRANT=1
