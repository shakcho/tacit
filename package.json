{
  "name": "tacit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "26.13.1",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "build": "pnpm generate && pnpm --recursive build",
    "dev": "node scripts/dev.mjs",
    "dev:api": "go run ./cmd/api",
    "dev:web": "pnpm --filter @tacit/web dev",
    "generate": "pnpm --recursive generate",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  }
}
