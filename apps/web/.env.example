# Server-only target used by the Next.js API proxy.
TACIT_API_ORIGIN=http://127.0.0.1:8080
TACIT_WEB_ORIGIN=http://127.0.0.1:3000

# Browser-safe root-relative base consumed by the generated Orval client.
NEXT_PUBLIC_API_BASE_PATH=/api

# WorkOS AuthKit. WORKOS_ISSUER must exactly match the access token's iss claim.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=generate_at_least_32_random_characters
WORKOS_ISSUER=https://replace-with-the-exact-token-issuer.example
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Optional for sign-in-only public-client mode; required for WorkOS management APIs.
# WORKOS_API_KEY=sk_test_replace_me
